<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="Detalii despre produsul cosmetic de înaltă calitate de la Beauty Hub. Aici vei găsi informații complete despre ingredientele, beneficiile și modul de utilizare al produsului nostru de makeup sau skincare. Descoperă cum acest produs poate îmbunătăți rutina ta de înfrumusețare și te poate ajuta să obții un look strălucitor și sănătos.">
        <meta name="keywords" content="cosmetice, beauty hub, makeup, skincare, accesorii, machiaj, ruj, fond de ten, paletă de farduri, mascara, tuș lichid, creion de buze, evenimente, natural, tendințe, <%- locals.prod.brand %>, <%- locals.prod.nume %>">
        
        <title>Beauty Hub - <%- locals.prod.nume %></title>
        <%- include("../fragmente/head") %>     
        <link href="/Resurse/Css/produs.css" type="text/css" rel="stylesheet" />
    </head>

        <%- include("../fragmente/header") %>
    <main>
        <section>
            <h2>Pagină produs</h2>
                <article id="art-produs">
                    <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                    <p>Brand: <span class="brand"><%- locals.prod.brand %></span></p>
                    <p>Pret: <span class="pret"><%- locals.prod.pret %> </span></p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.descriere %> </span></p>
                    <p>Ingrediente: <span class="ingrediente_cheie"><%- locals.prod.ingrediente_cheie %> </span></p>
                    <p>Gramaj: <span class="gramaj"><%- locals.prod.cantitate_ml_g %> </span>ml/g</p>
                    <p>Categorie: <span class="categorie-mare"><%- locals.prod.categorie_mare %> </span></p>
                    <p>Gamă: <span class="subcategorie"><%- locals.prod.subcategorie %></span></p>
                    <p>Zonă aplicare: <span class="zona"><%- locals.prod.zona_aplicare %></span></p>
                    <p>Cruelty Free: <span class="cruelty"><%- locals.prod.cruelty_free ? 'Da' : 'Nu' %></span></p>
                    <p>Data adăugare: <span class="data_adaugare"><%- locals.prod.data_adaugare %> </span></p>
                    <figure class="imag-produs">
                        <img  src="/Resurse/Imagini/produse/<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.nume %>]" />
                    </figure>    
                </article>
            
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>